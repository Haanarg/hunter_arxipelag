# Cloudflare Pages: no conservar HTML o manifests obsolets.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

/src/*.mjs
  Cache-Control: public, max-age=0, must-revalidate

# Nom amb empremta del contingut: el mateix URL conserva exactament el mateix JS.
/dist/*
  Cache-Control: public, max-age=31536000, immutable

# La versió de Three.js és fixa en el nom de l'arxiu.
/vendor/three-r186.module.mjs
  Cache-Control: public, max-age=604800

/assets/*
  Cache-Control: public, max-age=86400
