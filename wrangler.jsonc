{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hunter-arxipelag",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "previews": {},
  "main": "server/worker.mjs",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "17 4 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hunter-accounts",
      "database_id": "f4879e20-1085-4a51-b132-96cfad61cb90",
      "migrations_dir": "server/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SAVES",
      "bucket_name": "hunter-saves"
    }
  ],
  "vars": {
    "AUTH_ORIGIN": "https://hunter.paradoxa.cat"
  }
}
