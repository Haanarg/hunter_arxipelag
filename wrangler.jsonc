{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hunter-arxipelag",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "previews": {},
  "main": "server/worker.mjs",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "17 4 * * *"
    ]
  }
}
